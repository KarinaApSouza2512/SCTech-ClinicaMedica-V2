# Ambiente de execucao
NODE_ENV=development
PORT=3000

# PostgreSQL
# Em producao use so DATABASE_URL (tem prioridade sobre os campos abaixo)
DATABASE_URL=
# true para banco gerenciado (Neon, Render), que exige SSL
DB_SSL=false
DB_HOST=localhost
DB_PORT=5434
DB_USER=
DB_PASSWORD=
DB_NAME=sctec

# JSON Web Token
JWT_SECRET=
JWT_EXPIRES_IN=1d

# bcrypt
BCRYPT_SALT_ROUNDS=10

# Administrador inicial, criado pela seed (npm run seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
